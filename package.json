{
  "name": "facturaproec-admin",
  "version": "2.3.17",
  "description": "FacPro Server Manager - base de datos, túnel bore y servicios automáticos para FacturaPro",
  "author": "Democresss",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release": "node scripts/release.mjs",
    "gh:auth": "node scripts/gh-auth.mjs",
    "sync": "node scripts/sync-compartido.mjs",
    "build:bridge": "python scripts/build_bridge.py",
    "test:bridge": "python scripts/probar_backend.py"
  },
  "build": {
    "appId": "com.facturaproec.admin",
    "productName": "FacturaProEC Admin",
    "copyright": "Copyright © 2026 FacturaProEC",
    "directories": {
      "output": "dist-build",
      "buildResources": "resources"
    },
    "publish": {
      "provider": "github",
      "owner": "Democresss",
      "repo": "FacturaProEC-Admin",
      "releaseType": "draft"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "python-backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-bridge",
        "to": "bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python-backend",
        "to": "python-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "desktop_app",
        "to": "desktop-app",
        "filter": [
          "**/*.py",
          "**/*.txt",
          "**/*.json"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!python-runtime/**",
          "!__pycache__/**"
        ]
      },
      {
        "from": "resources/python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc",
          "!get-pip.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "FacturaProEC-Admin-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.icns",
      "artifactName": "FacturaProEC-Admin-${version}-${os}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/linux",
      "artifactName": "FacturaProEC-Admin-${version}-${os}-${arch}.${ext}",
      "category": "Office",
      "maintainer": "FacturaProEC <jairloorramirez@gmail.com>",
      "synopsis": "Tu base de datos, el túnel y los servicios automáticos para FacturaPro",
      "executableName": "facturaproec-admin",
      "desktop": {
        "Name": "FacPro Server Manager",
        "Comment": "Base de datos, archivos y túnel para FacturaPro",
        "Categories": "Office;Utility;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FacPro Server Manager",
      "uninstallDisplayName": "FacPro Server Manager",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
